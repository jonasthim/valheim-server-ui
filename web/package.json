{
  "name": "valheim-server-ui-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src",
    "preview": "vite preview",
    "gen:api": "npm_config_ignore_scripts=true npx --yes openapi-typescript@7.13.0 ../docs/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/dropzone": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/modals": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~5.9.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
