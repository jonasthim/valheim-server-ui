<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ValheimUI.SurvivalClient</AssemblyName>
    <RootNamespace>ValheimUI.SurvivalClient</RootNamespace>
    <Version>0.0.0</Version>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ValheimManaged Condition="'$(ValheimManaged)' == ''">$(MSBuildThisFileDirectory)../lib/valheim</ValheimManaged>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" IncludeAssets="compile" />
    <PackageReference Include="HarmonyX" Version="2.10.1" IncludeAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../SurvivalDeathKeys.cs" Link="SurvivalDeathKeys.cs" />
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
